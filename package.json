{
  "name": "@hraness/algal-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Reproducible research labs on ALGAL. The first compares how isolated and artifact-sharing researchers design networks that keep working as nodes fail.",
  "type": "module",
  "exports": {
    "./observation": "./src/instruments/observation.ts",
    "./observation-fixture": "./src/instruments/fixture/index.ts"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "discoveries:export": "bun scripts/export-discoveries.ts",
    "discovery": "bun scripts/discovery.ts",
    "lab": "bun cli.ts",
    "demo": "bun cli.ts study --protocol examples/network-study.json --out runs/demo",
    "demo:observation": "bun examples/observation-fixture.ts",
    "qualify": "bun cli.ts qualify --plan examples/qualification-plan.json --out runs/qualification",
    "qualify:instrument": "bun scripts/qualify-instrument.ts runs/instrument-qualification.json",
    "compare": "bun cli.ts compare --plan examples/comparison-plan.json --out runs/comparison",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run test",
    "compare:v2": "bun cli.ts compare --plan examples/comparison-plan-v2.json --out runs/comparison-v2",
    "study:tasks": "bun experiments/task-optimization/run.ts",
    "study:hosts": "bun experiments/host-comparison/compare.ts",
    "study:retention": "bun experiments/task-optimization/retention-run.ts"
  },
  "dependencies": {
    "@hraness/algal": "github:hraness/algal#0f73388df2093c52291687a9fccb6d170bdf2928"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
